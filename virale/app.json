{
  "expo": {
    "name": "Virale",
    "slug": "virale",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.virale.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "app.virale.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Virale",
      "backgroundColor": "#000000",
      "themeColor": "#000000",
      "output": "single"
    },
    "plugins": [
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Virale usa la galleria per pubblicare foto e video.",
          "cameraPermission": "Virale usa la fotocamera per registrare video e scattare foto.",
          "microphonePermission": "Virale usa il microfono per registrare video con audio."
        }
      ],
      "expo-router",
      "expo-font"
    ],
    "scheme": "virale",
    "experiments": {
      "typedRoutes": false
    }
  }
}
