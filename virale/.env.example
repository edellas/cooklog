# Copia questo file in .env.local (non finisce su git) e metti i valori del tuo progetto Supabase:
# Supabase → Project Settings → API (o "API Keys").
# La chiave da usare è quella pubblica "anon" / "publishable", MAI la "service_role".
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=incolla-qui-la-anon-key
