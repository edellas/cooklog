# Copia questo file in .env.local (non finisce su git) e metti i valori del tuo progetto Supabase:
# Supabase → Project Settings → API (o "API Keys").
# La chiave da usare è quella pubblica "anon" / "publishable", MAI la "service_role".
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=incolla-qui-la-anon-key

# Dati del titolare (documenti legali e contatti nell'app). Non vanno scritti nel codice: il repository è pubblico.
# Su expo.dev mettili in Environment variables, ambienti "preview" e "production", visibilità "Plain text".
EXPO_PUBLIC_OWNER_NAME=Nome Cognome
EXPO_PUBLIC_OWNER_ADDRESS=Via, numero, CAP, città
EXPO_PUBLIC_OWNER_TAX_ID=Codice fiscale o partita IVA
EXPO_PUBLIC_OWNER_EMAIL=supporto@esempio.it
EXPO_PUBLIC_OWNER_WEBSITE=
# Indirizzo della scheda App Store, appena esiste (facoltativo: senza, il sito dice "Presto su App Store").
EXPO_PUBLIC_APPSTORE_URL=

# Solo per le build EAS (non per .env.local): il file google-services.json di Firebase per le notifiche push
# su Android. Su expo.dev è una variabile di tipo "File" chiamata GOOGLE_SERVICES_JSON (vedi PUBBLICARE.md, passo 0.7).
